# Copy to .env (infra/scripts/setup.sh does this automatically).

# Ollama and Qdrant host interface. Keep localhost; use SSH for remote access.
BIND_ADDRESS=127.0.0.1

# Ollama
OLLAMA_IMAGE_TAG=0.40.14
OLLAMA_PORT=11434
OLLAMA_GPU_DEVICE=0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_MAX_QUEUE=64
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=15m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Bytes of VRAM Ollama keeps free when planning model placement (1 GiB).
OLLAMA_GPU_OVERHEAD=1073741824
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Qdrant
QDRANT_IMAGE_TAG=v1.20.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# URLs for host-side scripts and development
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333

# SQLite directory for host-side scripts; containers use /app/data/sqlite
SQLITE_DIR=data/sqlite

# Application services (published on localhost only)
BACKEND_PORT=8080
FRONTEND_PORT=8501
# URLs reachable from the backend container
APP_OLLAMA_URL=http://ollama:11434
APP_QDRANT_URL=http://qdrant:6333
